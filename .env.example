# Copy this file to .env for local testing (never commit the real .env).
# On Render, set these as real Environment Variables in the dashboard instead.

# Supabase -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key...

# A password only you know - required to create rooms. Make up any long random string.
ADMIN_KEY=change-me-to-something-long-and-random

# Render sets PORT itself; only needed for local runs.
PORT=4300

# Only used by scripts/backup-room.js (npm run backup) - where your deployed
# app lives. Defaults to the figue-rooms Render URL if you leave this unset.
ROOMS_BASE_URL=https://figue-rooms.onrender.com
